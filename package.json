{
  "name": "chikondi-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Official Chikondi website, Android APK download platform and release management.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-meta.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "release:publish": "node scripts/publish-apk.mjs",
    "release:manifest": "node scripts/generate-release-manifest.mjs",
    "assets:prepare": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.575.0",
    "motion": "^13.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.14",
    "vitest": "^3.2.4"
  }
}
