# ============================================================================
# Chikondi website — environment variables
# ============================================================================
# Copy this file to `.env.local` for local development. On Vercel set the same
# names in Project -> Settings -> Environment Variables.
#
# Nothing in this file is required for the site to render. The values below are
# what turn the download page, the contact form and the canonical URLs from
# "not configured" states into working ones. No secret below is ever exposed to
# the browser: only variables prefixed with VITE_ reach the client bundle.
# ============================================================================

# --- Public site -----------------------------------------------------------
# The real production origin, no trailing slash. Used for canonical URLs,
# Open Graph tags, sitemap.xml and robots.txt. Do NOT invent a domain — set
# this to the domain you actually deploy to.
# Example: https://chikondi.example
SITE_URL=

# --- Release download ------------------------------------------------------
# Where the published APK actually lives. The website never stores the APK in
# the repository; it publishes metadata and redirects to this location.
#
# /api/download and the Download page both read the release manifest
# (`src/data/release.json`), whose `downloadUrl` is what this override replaces.
# Leave blank to use the manifest's own downloadUrl.
#
# Examples:
#   https://github.com/OWNER/REPO/releases/download/v1.0.1/chikondi-1.0.1.apk
#   https://<project>.supabase.co/storage/v1/object/public/releases/chikondi-1.0.1.apk
#   https://<store>.public.blob.vercel-storage.com/chikondi-1.0.1.apk
RELEASE_DOWNLOAD_URL=

# Optional: overrides the version-independent stable link shown in the manifest
# (defaults to /downloads/chikondi.apk on this site).
RELEASE_STABLE_URL=

# --- Contact form ----------------------------------------------------------
# The form posts to /api/contact, which validates everything server-side and
# delivers through Resend (https://resend.com) over HTTPS — no SDK, no
# dependency. Without these two values the endpoint returns a clear 503 and the
# page shows the configured fallback instead of pretending a message was sent.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender/domain verified in Resend.
CONTACT_FROM_EMAIL=

# Shown as the fallback contact address when the form provider is not
# configured. Leave blank to hide the fallback entirely (never invent one).
CONTACT_FALLBACK_EMAIL=

# --- Contact form rate limiting (optional but recommended) -----------------
# Upstash Redis REST credentials. When present, /api/contact enforces a real
# sliding-window limit shared across serverless instances. When absent it still
# enforces validation, a honeypot and a minimum-time check.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
