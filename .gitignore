# Build output
dist/
.vercel/
*.local
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Dependencies
node_modules/

# Environment files (may contain keys). Never commit real values — only the
# placeholder template is tracked.
.env
.env.*
!.env.example

# Hosted release artifacts. An APK published with `npm run release:publish`
# lives in public/downloads/ and IS committed, because Vercel serves it directly
# from the deploy — that is the download platform. See README.md -> "Publishing
# an APK".
#
# public/releases/ is only a scratch drop-zone; its APKs are not committed.
public/releases/*.apk
!public/releases/.gitkeep

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

.vercel
